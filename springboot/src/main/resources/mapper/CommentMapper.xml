<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.CommentMapper">

    <resultMap id="commentWithExt" type="com.example.entity.Comment">
        <id column="id" property="id"/>
        <result column="goods_id" property="goodsId"/>
        <result column="user_id" property="userId"/>
        <result column="user_name" property="userName"/>
        <result column="content" property="content"/>
        <result column="rating" property="rating"/>
        <result column="order_id" property="orderId"/>
        <result column="time" property="time"/>
        <result column="goods_name" property="goodsName"/>
        <result column="goods_img" property="goodsImg"/>
        <result column="order_no" property="orderNo"/>
    </resultMap>

    <select id="selectAll" resultMap="commentWithExt">
        select c.*, g.name as goods_name, g.img as goods_img, o.order_no
        from `comment` c
        left join `goods` g on c.goods_id = g.id
        left join `orders` o on c.order_id = o.id
        <where>
            <if test="goodsId != null"> and c.goods_id = #{goodsId}</if>
            <if test="userId != null"> and c.user_id = #{userId}</if>
        </where>
        order by c.id desc
    </select>

    <select id="selectById" resultType="com.example.entity.Comment">
        select * from `comment` where id = #{id}
    </select>

    <delete id="deleteById">
        delete from `comment` where id = #{id}
    </delete>

    <insert id="insert" parameterType="com.example.entity.Comment" useGeneratedKeys="true" keyProperty="id">
        insert into `comment`(goods_id, user_id, user_name, content, rating, order_id, `time`)
        values (#{goodsId}, #{userId}, #{userName}, #{content}, #{rating}, #{orderId}, #{time})
    </insert>

    <update id="updateById" parameterType="com.example.entity.Comment">
        update `comment` set goods_id = #{goodsId}, user_id = #{userId}, user_name = #{userName},
            content = #{content}, rating = #{rating}, order_id = #{orderId}, `time` = #{time}
        where id = #{id}
    </update>

</mapper>
